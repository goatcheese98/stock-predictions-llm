  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true, "noEmit": true, "skipLibCheck": true
